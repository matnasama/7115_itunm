# Conexion local (activa por defecto). Mantener una sola DATABASE_URL activa.
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/club_moreno_itunm

# Neon: comentar la linea local y descomentar esta con tus credenciales.
# El formato postgresql:// sirve tanto para FastAPI como para Netlify.
DATABASE_URL=postgresql://USUARIO_NEON:CONTRASENA_NEON@TU_HOST-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# En Netlify cargar DATABASE_URL en las variables de entorno del sitio.
# Nunca usar VITE_DATABASE_URL: las variables VITE_ son publicas.
